#Machine
STATIC_IP=0.0.0.0
ZONE=us-east1-b
MACHINE_TYPE=e2-micro
INSTANCE_NAME=meus-lares
N_WORKERS=1
# Django
ENV=develop
HOST_BACK=localhost:9000
URL_BACK=http://localhost:9000
URL_FRONT=http://localhost:9001
SECRET_KEY=my_secret_key
API_PORT=9000
# Database
DB_NAME=meus-lares
DB_USER=admin
DB_PASSWORD=admin
DB_HOST_DOCKER=db
DB_HOST=127.0.0.1
DB_PORT_DOCKER=5432
DB_PORT=9002
# Vue3
GOOGLE_CLIENT_ID=google_client_id
INTERFACE_PORT=9001
# GOOGLE
GOOGLE_APPLICATION_CREDENTIALS=./gcloud/
GOOGLE_CLOUD_PROJECT_ID=123
GS_BUCKET_MEDIA=123
GS_BUCKET_STATIC=123
# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=email@gmail.com
EMAIL_HOST_PASSWORD=your_password
# Docker
IS_DOCKER=False